•        Available with optional thermometer for immediate temperature indication";s:14:"specifications";s:1106:"{"format":"andison_specs_v3","text":"","tables":[{"tableHtml":"<table><thead><tr><th>Voltage</th><th>120/240 Volts - Single Phase</th></tr></thead><tbody><tr><td>Temperature</td><td>100°F - 660°F Adjustable</td></tr><tr><td>Heating element</td><td>1,500 watts</td></tr><tr><td>Thermostat</td><td>Adjustable with indicator light</td></tr><tr><td>Thermometer</td><td>Optional door-mounted thermometer</td></tr><tr><td>Shelve Compartments</td><td>6 compartments</td></tr><tr><td>Insulation</td><td>Fiberglass batt (2.0 inches)</td></tr><tr><td>Chamber depth</td><td>19.00 inches</td></tr><tr><td>Chamber diameter</td><td>18.00 inches</td></tr></tbody></table>","tableMatrix":{"mode":"standard","headers":["Voltage","120/240 Volts - Single Phase"],"rows":[["Temperature","100°F - 660°F Adjustable"],["Heating element","1,500 watts"],["Thermostat","Adjustable with indicator light"],["Thermometer","Optional door-mounted thermometer"],["Shelve Compartments","6 compartments"],["Insulation","Fiberglass batt (2.0 inches)"],["Chamber depth","19.00 inches"],["Chamber diameter","18.00 inches"]],"merges":[]}}]}";s:5:"price";s:0:"";s:5:"image";s:119:"https://ldsvzhzgyfewwprizrok.supabase.co/storage/v1/object/public/product-images/type_300ht_pic_1_20260407_080352_0.jpg";s:10:"created_at";s:32:"2026-04-07T06:32:15.292033+00:00";s:18:"sub_subcategory_id";N;s:6:"images";a:2:{i:0;s:119:"https://ldsvzhzgyfewwprizrok.supabase.co/storage/v1/object/public/product-images/type_300ht_pic_1_20260407_080352_0.jpg";i:1;s:119:"https://ldsvzhzgyfewwprizrok.supabase.co/storage/v1/object/public/product-images/type_300ht_pic_2_20260407_080352_1.jpg";}s:9:"datasheet";s:0:"";}i:2;a:16:{s:2:"id";i:16658;s:11:"category_id";s:19:"welding-accessories";s:14:"subcategory_id";s:22:"welding-electrode-oven";s:5:"brand";s:10:"DryRod. II";s:12:"product_name";s:6:"Type 5";s:5:"model";s:23:"Portable Electrode Oven";